{
  "manifest_version": 3,
  "name": "악뮤 고양 킨텍스 예매 도우미",
  "version": "3.2.1",
  "description": "악뮤 고양 킨텍스 공연 전용 예매 준비·시작 알림·연속 좌석 선택 보조",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://ticket.yes24.com/*"
  ]
}
