{
  "manifest_version": 3,
  "name": "공연 예매 도우미",
  "version": "2.0.0",
  "description": "공연 링크 등록, 시작 알림, 화면 사전 점검과 확인한 버튼·연속 좌석 선택 보조",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
